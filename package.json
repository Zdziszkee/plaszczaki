{
  "name": "plaszczaki",
  "private": true,
  "type": "module",
  "workspaces": ["web"],
  "scripts": {
    "dev": "bun run --cwd web dev",
    "build": "bun run --cwd web build",
    "preview": "bun run --cwd web preview",
    "start": "bun run --cwd web start",
    "typecheck": "bun run --cwd web typecheck",
    "check": "biome check",
    "format": "biome format --write",
    "lint": "biome lint",
    "data:planned-rail": "bun run --cwd web data:planned-rail",
    "data:kolej-plus": "bun run --cwd web data:kolej-plus",
    "db:generate": "bun run --cwd web db:generate",
    "db:migrate": "bun run --cwd web db:migrate",
    "db:push": "bun run --cwd web db:push",
    "db:pull": "bun run --cwd web db:pull",
    "db:studio": "bun run --cwd web db:studio",
    "py:sync": "uv sync --directory scraper --locked",
    "py:lint": "uv run --directory scraper ruff check .",
    "py:format": "uv run --directory scraper ruff format .",
    "py:typecheck": "uv run --directory scraper ty check",
    "py:test": "uv run --directory scraper pytest",
    "py:check": "bun run py:lint && uv run --directory scraper ruff format --check && bun run py:typecheck",
    "deploy:up": "bash deploy/plaszczaki.sh up",
    "deploy:build": "bash deploy/plaszczaki.sh build",
    "deploy:down": "bash deploy/plaszczaki.sh down",
    "deploy:restart": "bash deploy/plaszczaki.sh restart",
    "deploy:restart-all": "bash deploy/plaszczaki.sh restart-all",
    "deploy:status": "bash deploy/plaszczaki.sh status",
    "deploy:logs": "bash deploy/plaszczaki.sh logs",
    "deploy:scraper-logs": "bash deploy/plaszczaki.sh logs scraper"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5"
  }
}
